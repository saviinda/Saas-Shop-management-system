rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // SaaS platform security rules:
    // Backend Node.js API with Firebase Admin SDK bypasses these rules securely.
    // Client-side direct access is locked to authenticated users.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
