{
  "info": {
    "_postman_id": "saas-comm-shop-mgmt-v1",
    "name": "SaaS Communication & Shop Management API v1.0",
    "description": "Comprehensive folder-wise Postman collection covering Super Admin and Shop Owner endpoints for the Multi-Tenant SaaS platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "shopId", "value": "shp_urban_cafe" },
    { "key": "branchId", "value": "br_urban_downtown" }
  ],
  "item": [
    {
      "name": "01. Authentication & Session",
      "item": [
        {
          "name": "Super Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    console.log('Saved adminToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@platform.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Shop Owner Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('ownerToken', jsonData.data.token);",
                  "    if (jsonData.data.shop) pm.collectionVariables.set('shopId', jsonData.data.shop.id);",
                  "    if (jsonData.data.defaultBranch) pm.collectionVariables.set('branchId', jsonData.data.defaultBranch.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@urbancafe.com\",\n  \"password\": \"Shop@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register New Shop Owner (BR-13 Auto-Branch Provisioning)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jonathan Wright\",\n  \"email\": \"jonathan.wright@gmail.com\",\n  \"password\": \"Secret@123456\",\n  \"phone\": \"+1 555 777 9999\",\n  \"businessName\": \"Artisan Bakery & Sweets\",\n  \"businessAddress\": \"88 Pastry Boulevard, Suite 10\",\n  \"businessCategory\": \"Bakery & Confectionery\",\n  \"packageId\": \"pkg_standard\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Get Authenticated User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "02. Super Admin - Shop Management",
      "item": [
        {
          "name": "List All Shops (Super Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/shops?status=all", "host": ["{{baseUrl}}"], "path": ["shops"], "query": [{ "key": "status", "value": "all" }] }
          }
        },
        {
          "name": "Get Single Shop Details & Package Usage",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/shops/{{shopId}}", "host": ["{{baseUrl}}"], "path": ["shops", "{{shopId}}"] }
          }
        },
        {
          "name": "Update Shop Status (Activate/Suspend/Restrict)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"restrictionNotes\": \"Account verified and approved by compliance team.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/shops/{{shopId}}/status", "host": ["{{baseUrl}}"], "path": ["shops", "{{shopId}}", "status"] }
          }
        },
        {
          "name": "Update Shop Profile (Owner permitted fields)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Urban Cafe Hub & Roastery\",\n  \"description\": \"Specialty roaster and artisan pastry kitchen.\",\n  \"openingHours\": \"Mon-Sun: 06:30 AM - 11:00 PM\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/shops/{{shopId}}/profile", "host": ["{{baseUrl}}"], "path": ["shops", "{{shopId}}", "profile"] }
          }
        }
      ]
    },
