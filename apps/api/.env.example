PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_for_saas_comm_shop_management_2026
CORS_ORIGIN=http://localhost:3000

# METHOD 1: (RECOMMENDED & EASIEST)
# Place your downloaded Firebase service account JSON in apps/api/ as "serviceAccountKey.json"
# OR specify the path:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# METHOD 2: Direct environment variables
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# =========================================================================
# EMAIL DISPATCH CONFIGURATION (BREVO RECOMMENDED)
# =========================================================================

# Option 1: Brevo Transactional Email REST API (RECOMMENDED - fast, port-independent)
# 1. Sign up at https://brevo.com
# 2. Go to SMTP & API -> API Keys -> Generate a new API key
# 3. Add your verified sender email from Brevo -> Senders & IP
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-email@domain.com
BREVO_SENDER_NAME="SaaS Platform Admin"

# Option 2: Brevo SMTP Relay (Alternative)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# BREVO_SMTP_USER=your-brevo-account-email@domain.com
# BREVO_SMTP_KEY=your-brevo-smtp-key
# SMTP_FROM="SaaS Platform Admin" <your-verified-email@domain.com>

# Option 3: Standard SMTP (Gmail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SaaS Platform Admin" <noreply@saasplatform.com>
